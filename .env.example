# ---------------------------------------------------------------------------
# Scrubs deployment configuration
#
# Copy to `.env` and fill in. These values are written into
# config/runtime-config.js at container start and served to every visitor's
# browser, so they are PUBLIC.
#
#   *** Never put a client secret, an API key, or any credential here. ***
#
# An OAuth *client ID* is safe to expose: it is protected by the authorised
# JavaScript origins you configure in Google Cloud, not by secrecy. Scrubs uses
# no API keys — every Google request is authorised with the signed-in user's own
# access token.
# ---------------------------------------------------------------------------

# REQUIRED. OAuth 2.0 Web client ID. See docs/SETUP.md.
SCRUBS_GOOGLE_CLIENT_ID=

# Optional. The Google Sheet holding this deployment's counters and default
# view. Accepts the bare ID. Leave empty to let each user attach their own
# sheet from the sign-in screen.
SCRUBS_DEFAULT_SPREADSHEET_ID=

# Optional. Tab names inside that spreadsheet.
SCRUBS_SETTINGS_TAB=Settings
SCRUBS_RULES_TAB=Rules

# ---------------------------------------------------------------------------
# Calendar permissions
#
# Google's OAuth scopes are per RESOURCE TYPE, not per resource: there is no
# scope that grants access to a single named calendar. The consent screen will
# always mention calendars in the plural. What you CAN control is how capable
# the scope is.
#
#   events  (default)  Read events on all calendars. Cannot read calendar
#                      settings, sharing rules, or anything else.
#   owned              Read events only on calendars this account OWNS. The
#                      narrowest option — but a roster calendar that was SHARED
#                      with the user will be invisible to it.
#   full               The broad "see and download any calendar" scope. Only
#                      needed if functionality beyond event reading is added.
SCRUBS_CALENDAR_ACCESS=events

# Whether to request the extra permission that lists calendars for the in-app
# picker. Set to `off` to drop one line from the consent screen; the calendars
# to count must then be named in SCRUBS_DEFAULT_CALENDAR_IDS or in the sheet.
SCRUBS_CALENDAR_PICKER=on

# Optional. Defaults used before the sheet is read, or when it omits a key.
# SCRUBS_DEFAULT_RANGE: last30 | last90 | mtd | ytd | last12months | thisYear |
#                       lastYear | thisMonth | next30 | next90 | all
SCRUBS_DEFAULT_RANGE=last12months
SCRUBS_DEFAULT_CALENDAR_IDS=primary
SCRUBS_COUNT_MODE=first
SCRUBS_WEEK_START=monday
SCRUBS_DEFAULT_HOURS_PER_SHIFT=0
SCRUBS_ALL_TIME_YEARS_BACK=5

# Optional. Host port for docker compose.
SCRUBS_PORT=8080
